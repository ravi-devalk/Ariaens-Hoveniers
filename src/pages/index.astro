---
import '../styles/global.css';
const base=import.meta.env.BASE_URL; const asset=(p:string)=>`${base}/${p}`.replace(/\/+/g,'/'); const canonical=new URL(base,Astro.site);
const title='Ariaens Hoveniers | Tuinaanleg en onderhoud'; const description='Drie onderscheidende websiteontwerpen voor Ariaens Hoveniers: tuinstudio, werkplaats en buitenarchitect.';
const schema={'@context':'https://schema.org','@type':'LandscapingBusiness',name:'Ariaens Hoveniers',description:'Specialist in tuinaanleg en onderhoud.',foundingDate:'2023',telephone:'+31631219202',url:canonical.href};
---
<!doctype html><html lang="nl" data-style="garden"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" href={asset('images/logo.jpg')}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:image" content={new URL(asset('images/stock/modern-patio.jpg'),Astro.site)}/><title>{title}</title><script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}/></head><body>
<a class="skip" href="#content">Ga naar de inhoud</a><aside class="switcher" aria-label="Kies een ontwerp"><span>Drie ontwerpen</span><div role="group"><button data-set-style="garden" aria-pressed="true"><b>01</b> Tuinstudio</button><button data-set-style="atelier" aria-pressed="false"><b>02</b> Werkplaats</button><button data-set-style="line" aria-pressed="false"><b>03</b> Buitenarchitect</button></div></aside>
<main id="content">
<div class="design design-garden"><header class="g-nav"><a class="brand" href="#g-top"><img src={asset('images/logo.jpg')} alt="Logo Ariaens Hoveniers"/><span>Ariaens <small>Hoveniers</small></span></a><nav><a href="#g-services">Diensten</a><a href="#g-result">Voor & na</a></nav><a class="pill" href="#g-contact">Offerte</a></header><section class="g-hero" id="g-top"><div><p class="kicker">Tuinaanleg en onderhoud</p><h1>Een tuin waar alles op zijn plek valt.</h1><p class="lead">Van eerste schets tot het laatste plantje. Ariaens maakt buitenruimtes die prettig leven en logisch aanvoelen.</p><a class="pill" href="#g-contact">Bespreek jouw tuin</a></div><figure><img src={asset('images/stock/modern-patio.jpg')} alt="Moderne patio met weelderige beplanting"/><figcaption>Inspiratiebeeld · Unsplash</figcaption></figure></section><section class="g-services" id="g-services"><p class="kicker">Wat we doen</p><h2>Van lege buitenruimte naar een tuin met ritme.</h2><div><article><b>01</b><h3>Ontwerp & aanleg</h3><p>Een compleet plan en een zorgvuldige uitvoering.</p></article><article><b>02</b><h3>Renovatie</h3><p>Een bestaande tuin opnieuw laten werken.</p></article><article><b>03</b><h3>Onderhoud</h3><p>Aandacht op de momenten dat het nodig is.</p></article></div></section><section class="g-editorial"><figure><img src={asset('images/stock/garden-path.jpg')} alt="Tuinpad met stapstenen en groene borders"/></figure><div><p class="kicker">Gemaakt om te gebruiken</p><h2>Groen, bestrating en hout als één geheel.</h2><p>De routes kloppen, er is ruimte om te zitten en het groen krijgt de juiste plek.</p></div><figure><img src={asset('images/stock/lush-garden.jpg')} alt="Weelderige tuin met pad en zitplek"/></figure></section><section class="g-before" id="g-result"><div><p class="kicker">Eén cleane vergelijking</p><h2>Van open erf naar een volwassen buitenruimte.</h2><p>Stockbeelden demonstreren de interactie; dit is geen claim over uitgevoerd werk.</p></div><div><div class="compare" style="--position:50%"><img class="before" src={asset('images/stock/empty-yard.jpg')} alt="Lege achtertuin vóór herinrichting"/><div class="after"><img src={asset('images/stock/modern-patio.jpg')} alt="Groene patio als inspiratie voor het eindresultaat"/></div><span class="tag before-tag">Voor</span><span class="tag after-tag">Na</span><span class="handle"></span><input type="range" min="0" max="100" value="50" aria-label="Vergelijk voor en na"/></div><div class="compare-buttons"><button data-position="8">Voor</button><button data-position="92">Na</button></div></div></section><section class="g-contact" id="g-contact"><h2>Klaar om buiten te beginnen?</h2><a class="pill light" href="tel:+31631219202">Bel 06 31 21 92 02</a></section></div>
<div class="design design-atelier"><header class="a-nav"><a href="#a-top">ARIAENS®<small>HOVENIERS / 2023</small></a><a href="#a-contact">START EEN PROJECT ↗</a></header><section class="a-hero" id="a-top"><figure><img src={asset('images/stock/lush-garden.jpg')} alt="Weelderige tuin met gelaagde beplanting"/><span>01 / BUITENLEVEN</span></figure><div><p>Ontwerp · aanleg · onderhoud</p><h1>Buiten<br/>wordt<br/><em>van jou.</em></h1><p>Een ambachtelijke werkplaats voor tuinen die karakter mogen krijgen.</p></div></section><div class="a-marquee"><span>ONTWERP</span>✳<span>AANLEG</span>✳<span>ONDERHOUD</span>✳<span>RENOVATIE</span></div><section class="a-manifest"><p>[ ONZE MANIER ]</p><h2>Niet vullen. Kijken, kiezen en precies genoeg doen.</h2><div><p>We beginnen bij hoe je buiten wilt leven. Daarna volgen lijnen, materialen en beplanting. Zo ontstaat één tuin.</p><ol><li><b>01</b> We komen kijken</li><li><b>02</b> We maken het plan</li><li><b>03</b> We bouwen buiten</li></ol></div></section><section class="a-gallery"><figure><img src={asset('images/stock/urban-garden.jpg')} alt="Hedendaagse stadstuin"/><figcaption>Vorm en groen</figcaption></figure><figure><img src={asset('images/stock/garden-path.jpg')} alt="Tuinpad met rustige materiaalkeuze"/><figcaption>Materiaal en ritme</figcaption></figure></section><section class="a-contact" id="a-contact"><p>Klaar voor buiten?</p><h2>Kom met een idee.<br/>Ga weg met een plan.</h2><a href="tel:+31631219202">06 31 21 92 02 ↗</a></section></div>
<div class="design design-line"><header class="l-nav"><a href="#l-top"><img src={asset('images/logo.jpg')} alt="Ariaens Hoveniers"/>ARIAENS<br/>HOVENIERS</a><span>NEDERLAND / SINDS 2023</span><a href="#l-contact">OFFERTE →</a></header><section class="l-hero" id="l-top"><div><span>BUITENRUIMTE / 001</span><h1>Wij bouwen<br/>de ruimte<br/>tussen huis<br/>en horizon.</h1></div><figure><img src={asset('images/stock/urban-garden.jpg')} alt="Architectonische tuin met sterke lijnen"/><figcaption>PROJECTSTUDIE / 52.02° N</figcaption></figure><aside><p>Ariaens ontwerpt, maakt en onderhoudt buitenruimtes.</p><a href="#l-projects">SELECTIE ↓</a></aside></section><section class="l-specs"><div><span>DISCIPLINE</span><b>Tuinaanleg</b></div><div><span>WERKWIJZE</span><b>Direct contact</b></div><div><span>FOCUS</span><b>Gebruik + vorm</b></div><div><span>START</span><b>2023</b></div></section><section class="l-projects" id="l-projects"><header><span>GESELECTEERD WERK / INSPIRATIE</span><h2>Ruimte krijgt richting.</h2></header><figure class="wide"><img src={asset('images/stock/modern-patio.jpg')} alt="Moderne groene patio"/><figcaption>STUDIE 01 — PATIO</figcaption></figure><figure><img src={asset('images/stock/garden-path.jpg')} alt="Pad door groene tuin"/><figcaption>STUDIE 02 — ROUTE</figcaption></figure><figure><img src={asset('images/stock/lush-garden.jpg')} alt="Weelderige tuin"/><figcaption>STUDIE 03 — GROEN</figcaption></figure></section><section class="l-process"><span>HOE WE WERKEN</span><ol><li><b>01</b><p>Kijken</p><small>De plek begrijpen.</small></li><li><b>02</b><p>Kaderen</p><small>Keuzes vastleggen.</small></li><li><b>03</b><p>Maken</p><small>Van grond tot groen.</small></li></ol></section><section class="l-contact" id="l-contact"><p>HEB JE EEN BUITENRUIMTE?</p><h2>Laat ’m werken.</h2><a href="tel:+31631219202">BEL 06 31 21 92 02 ↗</a></section></div>
</main><footer class="credits"><span>Ariaens Hoveniers · demo</span><a href="https://www.instagram.com/ariaens_hoveniers/">Instagram</a><a href={asset('CREDITS.md')}>Fotocredits</a></footer><script>const root=document.documentElement,buttons=document.querySelectorAll<HTMLButtonElement>('[data-set-style]');const setStyle=(s:string)=>{root.dataset.style=s;buttons.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.setStyle===s)));localStorage.setItem('ariaens-style',s);scrollTo({top:0,behavior:'instant'})};const stored=localStorage.getItem('ariaens-style');if(stored&&['garden','atelier','line'].includes(stored))setStyle(stored);buttons.forEach(b=>b.addEventListener('click',()=>setStyle(b.dataset.setStyle??'garden')));const compare=document.querySelector<HTMLElement>('.compare'),slider=compare?.querySelector<HTMLInputElement>('input');const update=(v:string)=>{compare?.style.setProperty('--position',`${v}%`);if(slider)slider.value=v};slider?.addEventListener('input',e=>update((e.currentTarget as HTMLInputElement).value));document.querySelectorAll<HTMLButtonElement>('[data-position]').forEach(b=>b.addEventListener('click',()=>update(b.dataset.position??'50')));</script></body></html>
