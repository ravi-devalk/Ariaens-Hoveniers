---
import '../styles/global.css';
import Essentials from '../components/Essentials.astro';
const base=import.meta.env.BASE_URL; const asset=(p:string)=>`${base}/${p}`.replace(/\/+/g,'/'); const canonical=new URL(base,Astro.site);
const title='Ariaens Hoveniers | Tuinaanleg en onderhoud'; const description='Drie onderscheidende websiteontwerpen voor Ariaens Hoveniers: tuinstudio, werkplaats en buitenarchitect.';
const schema={'@context':'https://schema.org','@type':'LandscapingBusiness',name:'Ariaens Hoveniers',description:'Specialist in tuinaanleg en onderhoud.',foundingDate:'2023',telephone:'+31631219202',url:canonical.href};
---
<!doctype html><html lang="nl" data-style="garden"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" href={asset('images/logo.jpg')}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:image" content={new URL(asset('images/stock/modern-patio.jpg'),Astro.site)}/><title>{title}</title><script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}/></head><body>
<a class="skip" href="#content">Ga naar de inhoud</a><aside class="switcher" aria-label="Kies een ontwerp"><span>Drie ontwerpen</span><div role="group"><button data-set-style="garden" aria-pressed="true"><b>01</b> Tuinstudio</button><button data-set-style="atelier" aria-pressed="false"><b>02</b> Werkplaats</button><button data-set-style="line" aria-pressed="false"><b>03</b> Garden gallery</button></div></aside>
<main id="content">
<Essentials />
<div class="design design-garden"><header class="g-nav"><a class="brand" href="#g-top"><img src={asset('images/logo.jpg')} alt="Logo Ariaens Hoveniers"/><span>Ariaens <small>Hoveniers</small></span></a><nav><a href="#g-services">Diensten</a><a href="#g-contact">Contact</a></nav><a class="pill" href="#g-contact">Offerte</a></header><section class="g-hero" id="g-top"><div><p class="kicker">Tuinaanleg en onderhoud</p><h1>Een tuin waar alles op zijn plek valt.</h1><p class="lead">Van eerste schets tot het laatste plantje. Ariaens maakt buitenruimtes die prettig leven en logisch aanvoelen.</p><a class="pill" href="#g-contact">Bespreek jouw tuin</a></div><figure><img src={asset('images/stock/modern-patio.jpg')} alt="Moderne patio met weelderige beplanting"/><figcaption>Inspiratiebeeld · Unsplash</figcaption></figure></section><section class="g-services" id="g-services"><p class="kicker">Wat we doen</p><h2>Van lege buitenruimte naar een tuin met ritme.</h2><div><article><b>01</b><h3>Ontwerp & aanleg</h3><p>Een compleet plan en een zorgvuldige uitvoering.</p></article><article><b>02</b><h3>Renovatie</h3><p>Een bestaande tuin opnieuw laten werken.</p></article><article><b>03</b><h3>Onderhoud</h3><p>Aandacht op de momenten dat het nodig is.</p></article></div></section><section class="g-editorial"><figure><img src={asset('images/stock/garden-path.jpg')} alt="Tuinpad met stapstenen en groene borders"/></figure><div><p class="kicker">Gemaakt om te gebruiken</p><h2>Groen, bestrating en hout als één geheel.</h2><p>De routes kloppen, er is ruimte om te zitten en het groen krijgt de juiste plek.</p></div><figure><img src={asset('images/stock/lush-garden.jpg')} alt="Weelderige tuin met pad en zitplek"/></figure></section><section class="g-contact" id="g-contact"><h2>Klaar om buiten te beginnen?</h2><a class="pill light" href="tel:+31631219202">Bel 06 31 21 92 02</a></section></div>
<div class="design design-atelier"><header class="a-nav"><a class="a-brand" href="#a-top"><img src={asset('images/logo.jpg')} alt="Logo Ariaens Hoveniers"/><span>Ariaens<small>Hoveniers / 2023</small></span></a><a href="#a-contact">START EEN PROJECT ↗</a></header><section class="a-hero" id="a-top"><div class="a-kinetic" aria-hidden="true"><span class="a-axis a-axis-x"></span><span class="a-axis a-axis-y"></span><span class="a-orbit a-orbit-one"><i></i><i></i></span><span class="a-orbit a-orbit-two"><i></i><i></i><i></i></span><span class="a-orbit a-orbit-three"><i></i></span><span class="a-core"></span></div><figure><img src={asset('images/stock/lush-garden.jpg')} alt="Weelderige tuin met gelaagde beplanting"/><span>01 / BUITENLEVEN</span></figure><div><p>Ontwerp · aanleg · onderhoud</p><h1>Buiten<br/>wordt<br/><em>van jou.</em></h1><p>Een ambachtelijke werkplaats voor tuinen die karakter mogen krijgen.</p></div></section><div class="a-marquee"><span>ONTWERP</span>✳<span>AANLEG</span>✳<span>ONDERHOUD</span>✳<span>RENOVATIE</span></div><section class="a-manifest"><p>[ ONZE MANIER ]</p><h2>Niet vullen. Kijken, kiezen en precies genoeg doen.</h2><div><p>We beginnen bij hoe je buiten wilt leven. Daarna volgen lijnen, materialen en beplanting. Zo ontstaat één tuin.</p><ol><li><b>01</b> We komen kijken</li><li><b>02</b> We maken het plan</li><li><b>03</b> We bouwen buiten</li></ol></div></section><section class="a-gallery"><figure><img src={asset('images/stock/urban-garden.jpg')} alt="Hedendaagse stadstuin"/><figcaption>Vorm en groen</figcaption></figure><figure><img src={asset('images/stock/garden-path.jpg')} alt="Tuinpad met rustige materiaalkeuze"/><figcaption>Materiaal en ritme</figcaption></figure></section><section class="a-contact" id="a-contact"><p>Klaar voor buiten?</p><h2>Kom met een idee.<br/>Ga weg met een plan.</h2><a href="tel:+31631219202">06 31 21 92 02 ↗</a></section></div>
<div class="design design-line">
  <header class="c-nav">
    <a class="c-brand" href="#c-top"><img src={asset('images/logo.jpg')} alt="Logo Ariaens Hoveniers"/><span>Ariaens <small>Hoveniers</small></span></a>
    <nav aria-label="Navigatie Garden gallery"><a href="#c-diensten">Diensten</a><a href="#c-projecten">Projecten</a><a href="#c-werkwijze">Werkwijze</a></nav>
    <a class="c-button" href="#c-contact">Plan een kennismaking</a>
  </header>
  <section class="c-hero" id="c-top">
    <div class="c-hero-copy"><p>Persoonlijke tuinaanleg en onderhoud</p><h1>Een buitenruimte die voelt als thuis.</h1><div><p>Doordachte lijnen, sterke materialen en groen dat met de seizoenen mooier wordt. Persoonlijk aangelegd door één vast aanspreekpunt.</p><a class="c-text-link" href="#c-projecten">Ontdek de aanpak <span>↘</span></a></div></div>
    <div class="c-hero-visual"><figure><img src={asset('images/stock/modern-patio.jpg')} alt="Moderne patio omringd door gelaagd groen"/><figcaption>Rust in vorm, rijkdom in groen</figcaption></figure><p><b>Van plan tot laatste plant</b><span>Heldere afspraken en direct contact tijdens het hele project.</span></p></div>
  </section>
  <section class="c-intro"><p>Ariaens brengt wonen en buitenleven samen in tuinen die helder zijn ontworpen en prettig blijven in gebruik.</p><dl><div><dt>Specialisatie</dt><dd>Luxere particuliere tuinen</dd></div><div><dt>Aanpak</dt><dd>Korte lijnen, verzorgd werk</dd></div></dl></section>
  <section class="c-services" id="c-diensten"><header><p>Wat Ariaens maakt</p><h2>Alles wat een goede tuin nodig heeft.</h2></header><div class="c-service-list"><article><span>01</span><h3>Ontwerp & aanleg</h3><p>Van indeling en materiaalkeuze tot een tuin die compleet wordt opgeleverd.</p></article><article><span>02</span><h3>Bestrating & houtbouw</h3><p>Terrassen, paden en maatwerk die één rustig geheel vormen met het groen.</p></article><article><span>03</span><h3>Onderhoud & snoeiwerk</h3><p>Gerichte verzorging waarmee beplanting sterk, gezond en in vorm blijft.</p></article></div></section>
  <section class="c-projects" id="c-projecten"><header><p>Tuinsferen</p><h2>Een eigen ritme voor iedere plek.</h2><p>Inspiratie voor materiaal, beplanting en gebruik. Tijdens een kennismaking vertalen we jouw wensen naar een passend plan.</p></header><div class="c-project-grid"><figure><img src={asset('images/stock/urban-garden.jpg')} alt="Besloten stadstuin met rustige lijnen"/><figcaption><b>Stadstuin</b><span>compact en geborgen</span></figcaption></figure><figure><img src={asset('images/stock/garden-path.jpg')} alt="Tuinpad tussen rijk begroeide borders"/><figcaption><b>Groene route</b><span>ritme en seizoenen</span></figcaption></figure><figure><img src={asset('images/stock/lush-garden.jpg')} alt="Weelderige tuin met verschillende groentinten"/><figcaption><b>Rijke borders</b><span>gelaagd en levendig</span></figcaption></figure></div></section>
  <section class="c-process" id="c-werkwijze"><div><p>Een overzichtelijk traject</p><h2>Van eerste gesprek tot verzorgd eindresultaat.</h2></div><ol><li><span>01</span><div><h3>Kennismaken</h3><p>We bespreken de tuin, jouw wensen en wat er praktisch nodig is.</p></div></li><li><span>02</span><div><h3>Keuzes vastleggen</h3><p>Je ontvangt een heldere offerte voor materialen en werkzaamheden.</p></div></li><li><span>03</span><div><h3>Zorgvuldig uitvoeren</h3><p>De tuin wordt aangelegd met één aanspreekpunt en korte lijnen.</p></div></li></ol></section>
  <section class="c-contact" id="c-contact"><div><p>Een tuinplan in gedachten?</p><h2>Laten we buiten afspreken.</h2></div><div><p>Vertel kort wat je wilt veranderen. Je krijgt persoonlijk antwoord van Ariaens Hoveniers.</p><a class="c-button c-button-light" href="tel:+31631219202">Bel 06 31 21 92 02</a><a class="c-text-link" href="#contactformulier">Of vraag online een offerte aan →</a></div></section>
</div>
</main><footer class="credits"><span>Ariaens Hoveniers · demo</span><a href="https://www.instagram.com/ariaens_hoveniers/">Instagram</a><a href={asset('CREDITS.md')}>Fotocredits</a><small>Gemaakt door <a href="https://ravi.nl/">Ravi WebDesign</a></small></footer><script>const root=document.documentElement,buttons=document.querySelectorAll<HTMLButtonElement>('[data-set-style]');const setStyle=(s:string)=>{root.dataset.style=s;buttons.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.setStyle===s)));localStorage.setItem('ariaens-style',s);scrollTo({top:0,behavior:'instant'})};const stored=localStorage.getItem('ariaens-style');if(stored&&['garden','atelier','line'].includes(stored))setStyle(stored);buttons.forEach(b=>b.addEventListener('click',()=>setStyle(b.dataset.setStyle??'garden')));</script></body></html>
