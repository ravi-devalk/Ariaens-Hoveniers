---
import '../styles/global.css';

const base = import.meta.env.BASE_URL;
const asset = (path: string) => `${base}/${path}`.replace(/\/+/g, '/');
const title = 'Ariaens Hoveniers | Tuinaanleg en onderhoud';
const description = 'Bekijk drie stijlen voor Ariaens Hoveniers, met echt projectbeeld, diensten en een directe route naar een offerte.';
const canonical = new URL(base, Astro.site);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'LandscapingBusiness',
  name: 'Ariaens Hoveniers',
  description: 'Specialist in tuinaanleg en onderhoud.',
  foundingDate: '2023',
  telephone: '+31631219202',
  url: canonical.href,
  sameAs: ['https://www.instagram.com/ariaens_hoveniers/'],
};
---
<!doctype html>
<html lang="nl" data-style="garden">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#164d32" />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={asset('images/logo.jpg')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(asset('images/project-1.jpg'), Astro.site)} />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#inhoud">Ga naar de inhoud</a>
    <aside class="style-dock" aria-label="Kies een ontwerpstijl">
      <span>Bekijk stijl</span>
      <div class="style-options" role="group" aria-label="Ontwerpstijlen">
        <button type="button" data-set-style="garden" aria-pressed="true"><i></i> Levend groen</button>
        <button type="button" data-set-style="atelier" aria-pressed="false"><i></i> Atelier buiten</button>
        <button type="button" data-set-style="line" aria-pressed="false"><i></i> Buitenlijn</button>
      </div>
    </aside>

    <header class="site-header">
      <a class="brand" href="#top" aria-label="Ariaens Hoveniers, naar boven">
        <img src={asset('images/logo.jpg')} width="52" height="52" alt="Logo van Ariaens Hoveniers" />
        <span><strong>Ariaens</strong><small>Hoveniers</small></span>
      </a>
      <nav aria-label="Hoofdnavigatie">
        <a href="#diensten">Diensten</a><a href="#projecten">Projecten</a><a href="#werkwijze">Werkwijze</a>
      </nav>
      <a class="button button-small" href="#offerte">Offerte aanvragen</a>
    </header>

    <main id="inhoud">
      <section class="hero" id="top">
        <div class="hero-copy">
          <p class="intro-line">Tuinaanleg & onderhoud · sinds 2023</p>
          <h1><span class="style-copy garden-copy">Van eerste idee tot een tuin die klopt.</span><span class="style-copy atelier-copy">Buitenruimte, met aandacht gemaakt.</span><span class="style-copy line-copy">Strakke lijnen. Levend resultaat.</span></h1>
          <p>Ariaens Hoveniers maakt en onderhoudt tuinen. Bekijk het werk en bespreek direct wat er buiten mogelijk is.</p>
          <div class="hero-actions"><a class="button" href="#offerte">Vraag een offerte aan</a><a class="text-link" href="#projecten">Bekijk projecten <span aria-hidden="true">↓</span></a></div>
        </div>
        <figure class="hero-image">
          <img src={asset('images/project-2.jpg')} alt="Aangelegde tuin door Ariaens Hoveniers" width="640" height="640" fetchpriority="high" />
          <figcaption>Projectbeeld · Ariaens Hoveniers</figcaption>
        </figure>
      </section>

      <section class="services" id="diensten" aria-labelledby="diensten-titel">
        <div class="section-heading"><h2 id="diensten-titel">Goed buiten begint met helder werk.</h2><p>Van een complete aanleg tot terugkerend onderhoud: kies wat jouw tuin nodig heeft.</p></div>
        <div class="service-list">
          <article><span aria-hidden="true">01</span><div><h3>Tuinaanleg</h3><p>Een nieuwe tuin of een grondige vernieuwing, van basis tot afwerking.</p></div></article>
          <article><span aria-hidden="true">02</span><div><h3>Tuinonderhoud</h3><p>Vakkundige aandacht voor groen, bestrating en de uitstraling van je tuin.</p></div></article>
          <article><span aria-hidden="true">03</span><div><h3>Tuinrenovatie</h3><p>Behoud wat werkt en geef versleten delen een sterke nieuwe basis.</p></div></article>
        </div>
      </section>

      <section class="projects" id="projecten" aria-labelledby="projecten-titel">
        <div class="section-heading"><h2 id="projecten-titel">Werk dat je kunt bekijken.</h2><p>Openbare projectbeelden van Ariaens Hoveniers, zonder opgepoetste claims.</p></div>
        <div class="project-grid">
          <figure><img src={asset('images/project-1.jpg')} alt="Tuinproject van Ariaens Hoveniers" width="640" height="640" loading="lazy" /><figcaption>Tuinaanleg <span>Bekijk detail</span></figcaption></figure>
          <figure><img src={asset('images/project-2.jpg')} alt="Groen eindresultaat van een tuinproject" width="640" height="640" loading="lazy" /><figcaption>Eindresultaat <span>Bekijk detail</span></figcaption></figure>
        </div>
      </section>

      <section class="comparison" aria-labelledby="vergelijk-titel">
        <div class="comparison-copy"><p>Interactieve demo</p><h2 id="vergelijk-titel">Sleep van eerste beeld naar eindresultaat.</h2><p>Deze demo gebruikt twee beschikbare projectbeelden om de voor-en-na-interactie te laten zien.</p></div>
        <div class="compare-wrap">
          <div class="compare" style="--position: 50%">
            <img class="compare-before" src={asset('images/project-1.jpg')} alt="Eerste projectbeeld" />
            <div class="compare-after"><img src={asset('images/project-2.jpg')} alt="Eindresultaat van het project" /></div>
            <span class="compare-label before-label">Voor</span><span class="compare-label after-label">Na</span><span class="compare-line" aria-hidden="true"></span>
            <input type="range" min="0" max="100" value="50" aria-label="Vergelijk voor en na" />
          </div>
          <div class="compare-controls" aria-label="Snelle vergelijking"><button type="button" data-position="15">Bekijk voor</button><button type="button" data-position="85">Bekijk na</button></div>
        </div>
      </section>

      <section class="process" id="werkwijze" aria-labelledby="werkwijze-titel">
        <div class="section-heading"><h2 id="werkwijze-titel">Van vraag naar buitenruimte.</h2><p>Een korte route die ruimte laat voor jouw tuin en wensen.</p></div>
        <ol><li><strong>Kennismaken</strong><span>Vertel wat je wilt veranderen.</span></li><li><strong>Plan & offerte</strong><span>Je krijgt een duidelijk voorstel.</span></li><li><strong>Aan de slag</strong><span>Het werk wordt zorgvuldig uitgevoerd.</span></li></ol>
      </section>

      <section class="quote" id="offerte" aria-labelledby="offerte-titel">
        <div><p>Klaar om buiten te beginnen?</p><h2 id="offerte-titel">Vertel kort wat je voor je tuin zoekt.</h2><a class="phone-link" href="tel:+31631219202">Bel 06 31 21 92 02</a></div>
        <form id="offerte-formulier">
          <label>Naam<input name="naam" autocomplete="name" required /></label>
          <label>Telefoon<input name="telefoon" type="tel" autocomplete="tel" required /></label>
          <label>Waarmee kunnen we helpen?<select name="dienst"><option>Tuinaanleg</option><option>Tuinonderhoud</option><option>Tuinrenovatie</option><option>Anders</option></select></label>
          <label class="full">Korte toelichting<textarea name="vraag" rows="3"></textarea></label>
          <button class="button full" type="submit">Offerte aanvragen</button><output class="full" aria-live="polite"></output>
        </form>
      </section>
    </main>
    <footer><a class="brand" href="#top"><img src={asset('images/logo.jpg')} width="44" height="44" alt="" /><span><strong>Ariaens</strong><small>Hoveniers</small></span></a><p>Specialist in tuinaanleg & onderhoud · sinds 2023</p><a href="https://www.instagram.com/ariaens_hoveniers/">Instagram</a></footer>

    <script>
      const root = document.documentElement;
      const buttons = document.querySelectorAll<HTMLButtonElement>('[data-set-style]');
      const setStyle = (style: string) => {
        root.dataset.style = style;
        buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.setStyle === style)));
        localStorage.setItem('ariaens-style', style);
      };
      const stored = localStorage.getItem('ariaens-style');
      if (stored && ['garden','atelier','line'].includes(stored)) setStyle(stored);
      buttons.forEach((button) => button.addEventListener('click', () => setStyle(button.dataset.setStyle ?? 'garden')));
      const compare = document.querySelector<HTMLElement>('.compare');
      const slider = compare?.querySelector<HTMLInputElement>('input');
      const update = (value: string) => { compare?.style.setProperty('--position', `${value}%`); if (slider) slider.value = value; };
      slider?.addEventListener('input', (event) => update((event.currentTarget as HTMLInputElement).value));
      document.querySelectorAll<HTMLButtonElement>('[data-position]').forEach((button) => button.addEventListener('click', () => update(button.dataset.position ?? '50')));
      document.querySelector<HTMLFormElement>('#offerte-formulier')?.addEventListener('submit', (event) => {
        event.preventDefault();
        const output = (event.currentTarget as HTMLFormElement).querySelector('output');
        if (output) output.textContent = 'Dank je. Dit is een demo; er is niets verstuurd.';
      });
    </script>
  </body>
</html>
