---
import '../styles/global.css';
import Seo from '@jdevalk/astro-seo-graph/Seo.astro';

const base = import.meta.env.BASE_URL;
const asset = (path: string) => `${base}/${path}`.replace(/\/+/g, '/');
const page = (path: string) => path;
const canonical = new URL(base, Astro.site);
const title = 'Ariaens Hoveniers | Tuinaanleg en onderhoud in Wijchen';
const description = 'Ariaens Hoveniers legt tuinen aan, renoveert en verzorgt tuinonderhoud in Wijchen, Druten en omgeving. Bespreek je tuin direct met Jaap.';
const whatsapp = 'https://wa.me/31631219202?text=Hallo%20Jaap%2C%20ik%20wil%20graag%20mijn%20tuin%20bespreken.';
const schema = {
  '@context': 'https://schema.org', '@type': 'LandscapingBusiness', name: 'Ariaens Hoveniers',
  description: 'Persoonlijk hovenierswerk voor aanleg, renovatie, onderhoud en tuinoptimalisatie.',
  telephone: '+31631219202', email: 'info@arienshoveniers.nl', areaServed: ['Wijchen', 'Druten', 'Nijmegen'],
  url: canonical.href, sameAs: ['https://www.instagram.com/ariaens_hoveniers/'],
};
---
<!doctype html>
<html lang="nl">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#0b0d0c" /><link rel="icon" href={asset('images/logo.jpg')} />
  <Seo title={title} description={description} canonical={canonical} siteName="Ariaens Hoveniers" locale="nl_NL" ogImage={new URL(asset('images/stock/modern-patio.jpg'), Astro.site).href} ogImageAlt="Moderne tuin met natuursteen, hout en rijk groen" graph={schema} twitter={{ card: 'summary_large_image' }} />
</head>
<body>
  <a class="skip-link" href="#inhoud">Ga naar de inhoud</a>
  <header class="site-header">
    <a class="wordmark" href="#top" aria-label="Ariaens Hoveniers, naar boven"><img src={asset('images/logo.jpg')} alt="" width="150" height="150" /></a>
    <nav aria-label="Hoofdnavigatie"><a href="#tuinaanleg">Tuinaanleg</a><a href="#onderhoud">Onderhoud</a><a href="#tuinoptimalisatie">Tuinoptimalisatie</a><a href={page('over-ons/')}>Over ons</a></nav>
    <a class="button button-small" href={whatsapp}>Bespreek je tuin <span aria-hidden="true">↗</span></a>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-menu">Menu</button>
    <div class="mobile-menu" id="mobile-menu" hidden><a href="#tuinaanleg">Tuinaanleg</a><a href="#onderhoud">Onderhoud</a><a href="#tuinoptimalisatie">Tuinoptimalisatie</a><a href="#projecten">Projecten</a><a href={page('over-ons/')}>Over ons</a><a href="#contact">Contact</a></div>
  </header>
  <main id="inhoud">
    <section class="hero" id="top">
      <div class="hero-copy"><p class="intro-label">Tuinaanleg · onderhoud · optimalisatie</p><h1>Oog voor detail.</h1><p class="hero-lead">Wij maken en onderhouden buitenruimtes die zorgvuldig zijn opgebouwd, prettig werken en jarenlang mooi blijven.</p><div class="hero-actions"><a class="button" href={whatsapp}>Bespreek je tuin via WhatsApp <span aria-hidden="true">↗</span></a><a class="text-link" href="#projecten">Bekijk het werk <span aria-hidden="true">↓</span></a></div></div>
      <figure class="hero-image"><img src={asset('images/stock/modern-patio.jpg')} alt="Moderne tuin met natuursteen, hout en rijk groen" width="1800" height="2507" fetchpriority="high" /><figcaption>Sfeerbeeld van een hoogwaardige, groene buitenruimte</figcaption></figure>
      <svg class="root-system root-hero" viewBox="0 0 1440 799" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M0 0H720V170C720 236 670 252 617 283C551 321 581 386 489 416C408 442 312 411 246 480C213 515 205 578 151 638"/><path pathLength="1" d="M0 0H720V196C720 277 769 297 814 338C865 385 832 443 907 479C969 509 1064 480 1121 537C1145 561 1158 600 1204 638"/><path pathLength="1" d="M720 142C689 235 628 227 563 243C473 266 456 323 374 331C302 338 269 308 195 316"/><path pathLength="1" d="M720 162C759 229 825 232 899 250C978 270 1007 327 1090 335C1148 340 1197 325 1262 355"/></svg>
    </section>

    <section class="statement"><p>Een tuin is pas af als ook de basis klopt.</p><h2>Wij kijken verder dan wat je op het eerste gezicht ziet.</h2></section>

    <section class="services section" id="diensten">
      <header class="section-heading"><p class="section-index">Onze expertise</p><h2>Drie disciplines. Eén vertrouwd team.</h2></header>
      <div class="service-list">
        <article id="tuinaanleg"><span>01</span><div><h3>Tuinaanleg</h3><p>Van grondwerk en bestrating tot beplanting en renovatie. Wij bouwen de tuin zorgvuldig op als één kloppend geheel.</p></div><a href={whatsapp}>Bespreek je plan ↗</a></article>
        <article id="onderhoud"><span>02</span><div><h3>Onderhoud</h3><p>Wij verzorgen niet alleen snoeiwerk en groen, maar houden ook verlichting en andere onderdelen van de tuin in het oog.</p></div><a href={whatsapp}>Bespreek onderhoud ↗</a></article>
        <article id="tuinoptimalisatie"><span>03</span><div><h3>Tuinoptimalisatie</h3><p>Beregening, verlichting en robotmaaiers slim ingesteld, zodat de tuin krijgt wat nodig is en niets onnodig draait.</p></div><a href={whatsapp}>Optimaliseer je tuin ↗</a></article>
      </div>
    </section>

    <section class="projects" id="projecten">
      <header class="projects-heading"><p>Projecten & vakwerk</p><h2>Buiten gemaakt.</h2><p>Echte beelden van Ariaens worden aangevuld zodra de nieuwe projectfotografie klaar is.</p></header>
      <div class="project-grid">
        <figure class="project-main"><img src={asset('images/stock/lush-garden.jpg')} alt="Weelderige tuin met gelaagde beplanting en een rustige zitplek" width="1800" height="2700" loading="lazy" /><figcaption><span>Beplanting & onderhoud</span><small>Sfeerbeeld</small></figcaption></figure>
        <figure class="project-wide"><img src={asset('images/stock/garden-path.jpg')} alt="Stapstenen door een rijk beplante tuin" width="1800" height="2700" loading="lazy" /><figcaption><span>Groen & routing</span><small>Sfeerbeeld</small></figcaption></figure>
        <figure class="project-real"><img src={asset('images/project-2.jpg')} alt="Houten pergola in aanbouw door Ariaens Hoveniers" width="480" height="640" loading="lazy" /><figcaption><span>Pergola in uitvoering</span><small>Werk van Ariaens</small></figcaption></figure>
      </div>
    </section>

    <section class="about section" id="over-ons">
      <div class="about-portrait"><img src={asset('images/project-1.jpg')} alt="Jaap Ariaens van Ariaens Hoveniers" width="480" height="640" loading="lazy" /><span>Jaap Ariaens</span></div>
      <div class="about-copy"><p class="section-index">Over ons</p><h2>Je weet wie er in je tuin staat.</h2><p class="about-lead">Wij werken persoonlijk, direct en met een vaste groep vakmensen. Jaap blijft zelf betrokken en bewaakt de kwaliteit van begin tot eind.</p><p>Die betrokkenheid begon al vroeg. Op zijn dertiende werkte Jaap mee bij een boer; twee jaar later zette hij zijn eerste stappen bij een hoveniersbedrijf.</p><a class="inline-button" href={page('over-ons/')}>Lees het hele verhaal ↗</a><blockquote>“Als ik klaar denk te zijn, loop ik altijd nog één ronde. Er is altijd een detail dat aandacht verdient.”</blockquote></div>
    </section>

    <section class="certainties"><h2>Zo werken wij.</h2><ul><li><span>01</span><strong>Eén vast aanspreekpunt</strong><p>Direct contact met Jaap, zonder mensen ertussen.</p></li><li><span>02</span><strong>Degelijk opgebouwd</strong><p>Aandacht voor de basis, materialen en lange levensduur.</p></li><li><span>03</span><strong>Netjes achtergelaten</strong><p>Na het werk wordt de tuin verzorgd opgeleverd.</p></li><li><span>04</span><strong>Snel bereikbaar</strong><p>Een vraag of foto deel je gemakkelijk via WhatsApp.</p></li></ul></section>

    <section class="area section"><div><p class="section-index">Dichtbij huis</p><h2>Werkgebied</h2></div><div><p>Wij werken voornamelijk in Wijchen en omgeving. Ook voor passende projecten in Druten en Nijmegen kun je direct contact opnemen.</p><ul aria-label="Werkgebied"><li>Wijchen</li><li>Druten</li><li>Nijmegen</li><li>Directe omgeving</li></ul></div></section>

    <section class="contact" id="contact">
      <svg class="root-system root-contact" viewBox="0 0 1440 560" preserveAspectRatio="none" aria-hidden="true"><path d="M720 560V420C720 350 660 329 609 288C552 243 586 182 502 145C432 114 351 143 278 85C249 62 229 28 205 0"/><path d="M720 560V438C720 357 777 332 832 291C895 244 865 190 940 150C1010 112 1084 131 1169 67C1197 46 1218 22 1237 0"/></svg>
      <div class="contact-inner"><p>Een nieuwe tuin, renovatie of beter onderhoud?</p><h2>Vertel Jaap wat je voor ogen hebt.</h2><a class="button button-light" href={whatsapp}>Start een WhatsApp-gesprek <span aria-hidden="true">↗</span></a><div class="contact-options"><a href="tel:+31631219202">06 31 21 92 02</a><a href="mailto:info@arienshoveniers.nl">info@arienshoveniers.nl</a></div></div>
    </section>
  </main>
  <footer><a class="footer-logo" href="#top"><img src={asset('images/logo.jpg')} alt="Ariaens Hoveniers" width="150" height="150" /></a><div><p>Tuinaanleg · renovatie · onderhoud</p><p>Wijchen en omgeving</p></div><div><a href="https://www.instagram.com/ariaens_hoveniers/">Instagram ↗</a><span>Sfeerbeelden: Unsplash</span></div><small>Gemaakt door <a href="https://ravi.nl/">Ravi WebDesign</a></small></footer>
  <a class="whatsapp" href={whatsapp} aria-label="Stuur Ariaens Hoveniers een WhatsApp-bericht"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16.1 3.2A12.6 12.6 0 0 0 5.4 22.5L3.7 28.8l6.4-1.7a12.6 12.6 0 1 0 6-23.9Zm0 22.9c-1.9 0-3.7-.5-5.3-1.4l-.4-.2-3.8 1 1-3.7-.2-.4a10.3 10.3 0 1 1 8.7 4.7Zm5.7-7.7c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-.9 1.2-.2.2-.3.2-.7.1-1.8-.9-3-1.6-4.2-3.7-.3-.6.3-.5.9-1.7.1-.2.1-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.2-1.2 3s1.3 3.5 1.5 3.7c.2.2 2.6 4 6.4 5.6.9.4 1.6.6 2.1.8.9.3 1.7.2 2.4.1.7-.1 1.9-.8 2.2-1.5.3-.7.3-1.4.2-1.5-.1-.2-.3-.3-.6-.5Z"/></svg><b>WhatsApp</b></a>
  <script>
    const button = document.querySelector<HTMLButtonElement>('.menu-button'); const menu = document.querySelector<HTMLElement>('#mobile-menu');
    button?.addEventListener('click', () => { const open = button.getAttribute('aria-expanded') === 'true'; button.setAttribute('aria-expanded', String(!open)); if (menu) menu.hidden = open; });
    menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => { button?.setAttribute('aria-expanded', 'false'); if (menu) menu.hidden = true; }));
  </script>
</body>
</html>
