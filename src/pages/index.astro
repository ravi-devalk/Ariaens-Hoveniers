---
import '../styles/global.css';
import Seo from '@jdevalk/astro-seo-graph/Seo.astro';

const base = import.meta.env.BASE_URL;
const asset = (path: string) => `${base}/${path}`.replace(/\/+/g, '/');
const page = (path: string) => path;
const canonical = new URL(base, Astro.site);
const title = 'Ariaens Hoveniers | Tuinaanleg en onderhoud in Wijchen';
const description = 'Ariaens Hoveniers legt tuinen aan, renoveert en verzorgt tuinonderhoud in Wijchen, Druten en omgeving. Bespreek je tuin direct met Jaap.';
const whatsapp = 'https://wa.me/31631219202?text=Hallo%20Jaap%2C%20ik%20wil%20graag%20mijn%20tuin%20bespreken.';
const schema = {
  '@context': 'https://schema.org', '@type': 'LandscapingBusiness', name: 'Ariaens Hoveniers',
  description: 'Persoonlijk hovenierswerk voor aanleg, renovatie, onderhoud en tuinoptimalisatie.',
  telephone: '+31631219202', email: 'info@arienshoveniers.nl', areaServed: ['Wijchen', 'Druten', 'Nijmegen'],
  url: canonical.href, sameAs: ['https://www.instagram.com/ariaens_hoveniers/'],
};
---
<!doctype html>
<html lang="nl">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#0b0d0c" /><link rel="icon" href={asset('images/logo.jpg')} />
  <Seo title={title} description={description} canonical={canonical} siteName="Ariaens Hoveniers" locale="nl_NL" ogImage={new URL(asset('images/ariaens/jaap-bedrijfswagen.webp'), Astro.site).href} ogImageAlt="Jaap tussen de bedrijfswagen en aanhanger van Ariaens Hoveniers" graph={schema} twitter={{ card: 'summary_large_image' }} />
</head>
<body>
  <a class="skip-link" href="#inhoud">Ga naar de inhoud</a>
  <header class="site-header">
    <a class="wordmark" href="#top" aria-label="Ariaens Hoveniers, naar boven"><img src={asset('images/logo.jpg')} alt="" width="150" height="150" /></a>
    <nav aria-label="Hoofdnavigatie"><a href={page('tuinaanleg/')}>Tuinaanleg</a><a href={page('onderhoud/')}>Onderhoud</a><a href={page('tuinoptimalisatie/')}>Tuinoptimalisatie</a><a href={page('over-ons/')}>Over ons</a></nav>
    <a class="button button-small" href={whatsapp}>Bespreek je tuin</a>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-menu">Menu</button>
    <div class="mobile-menu" id="mobile-menu" hidden><a href={page('tuinaanleg/')}>Tuinaanleg</a><a href={page('onderhoud/')}>Onderhoud</a><a href={page('tuinoptimalisatie/')}>Tuinoptimalisatie</a><a href="#projecten">Projecten</a><a href={page('over-ons/')}>Over ons</a><a href="#contact">Contact</a></div>
  </header>
  <main id="inhoud">
    <svg class="site-vines" viewBox="0 0 1280 6200" preserveAspectRatio="none" aria-hidden="true">
      <path pathLength="1" d="M0 0H470C590 0 620 94 620 210C620 410 430 430 430 650C430 880 720 860 720 1110C720 1370 980 1370 980 1650C980 1930 690 1950 690 2240C690 2540 330 2570 330 2860C330 3180 610 3200 610 3500C610 3810 920 3850 920 4160C920 4480 680 4520 680 4820C680 5140 390 5200 390 5500C390 5780 570 5900 570 6200"/>
      <path pathLength="1" d="M0 10H456C574 10 604 102 604 216C604 400 414 422 414 654C414 896 704 876 704 1116C704 1382 964 1380 964 1656C964 1918 674 1942 674 2246C674 2552 314 2558 314 2866C314 3192 594 3210 594 3506C594 3822 904 3860 904 4166C904 4492 664 4530 664 4826C664 5152 374 5210 374 5506C374 5792 554 5910 554 6200"/>
      <path class="site-root" pathLength="1" d="M430 650C334 704 274 790 250 902C226 1010 166 1082 64 1128"/><path class="site-twig" pathLength="1" d="M304 758C244 744 196 708 164 650"/><path class="site-twig" pathLength="1" d="M250 902C320 930 360 976 378 1042"/><path class="site-twig" pathLength="1" d="M170 1038C128 1018 92 982 70 936"/>
      <path class="site-root" pathLength="1" d="M720 1110C812 1168 854 1254 836 1360C816 1476 866 1562 970 1628"/><path class="site-twig" pathLength="1" d="M802 1220C864 1206 916 1170 952 1114"/><path class="site-twig" pathLength="1" d="M836 1360C770 1400 734 1452 722 1518"/><path class="site-twig" pathLength="1" d="M914 1586C974 1572 1026 1534 1060 1478"/>
      <path class="site-root" pathLength="1" d="M690 2240C586 2288 530 2372 520 2484C510 2596 448 2680 344 2738"/><path class="site-twig" pathLength="1" d="M566 2330C508 2318 454 2282 416 2228"/><path class="site-twig" pathLength="1" d="M520 2484C586 2512 632 2560 650 2624"/><path class="site-twig" pathLength="1" d="M408 2688C354 2666 312 2624 288 2568"/>
      <path class="site-root" pathLength="1" d="M610 3500C710 3548 764 3630 762 3740C760 3854 824 3936 934 3990"/><path class="site-twig" pathLength="1" d="M716 3590C770 3568 816 3528 842 3472"/><path class="site-twig" pathLength="1" d="M762 3740C702 3780 666 3830 654 3894"/><path class="site-twig" pathLength="1" d="M868 3960C922 3938 970 3896 998 3838"/>
      <path class="site-root" pathLength="1" d="M680 4820C572 4872 516 4958 508 5074C500 5192 426 5274 312 5330"/><path class="site-twig" pathLength="1" d="M554 4914C494 4894 446 4854 416 4798"/><path class="site-twig" pathLength="1" d="M508 5074C574 5104 616 5150 634 5216"/><path class="site-twig" pathLength="1" d="M390 5292C334 5270 288 5228 262 5170"/>
      <path class="site-root" pathLength="1" d="M390 5500C486 5562 526 5650 500 5760C474 5870 518 5964 616 6032"/><path class="site-twig" pathLength="1" d="M480 5620C540 5608 588 5574 624 5520"/><path class="site-twig" pathLength="1" d="M500 5760C438 5794 398 5842 382 5906"/><path class="site-twig" pathLength="1" d="M560 5988C616 5972 664 5938 698 5884"/>
    </svg>
    <section class="hero" id="top">
      <div class="hero-copy"><p class="intro-label">Tuinaanleg · onderhoud · optimalisatie</p><h1>Oog voor detail.</h1><p class="hero-lead">Wij maken en onderhouden buitenruimtes die zorgvuldig zijn opgebouwd, prettig werken en jarenlang mooi blijven.</p><div class="hero-actions"><a class="button" href={whatsapp}>Bespreek je tuin via WhatsApp</a><a class="text-link" href="#projecten">Bekijk het werk</a></div></div>
      <figure class="hero-image hero-image-brand"><img src={asset('images/ariaens/jaap-bedrijfswagen.webp')} alt="Jaap tussen de bedrijfswagen en aanhanger van Ariaens Hoveniers" width="1920" height="1280" fetchpriority="high" /><figcaption>Jaap Ariaens · Wijchen</figcaption></figure>
    </section>

    <section class="statement"><p>Een tuin is pas af als ook de basis klopt.</p><h2>Wij kijken verder dan wat je op het eerste gezicht ziet.</h2></section>

    <section class="services section" id="diensten">
      <header class="section-heading"><p class="section-index">Onze expertise</p><h2>Drie disciplines. Eén vertrouwd team.</h2></header>
      <div class="service-list">
        <article id="tuinaanleg"><span>01</span><div><h3>Tuinaanleg</h3><p>Van grondwerk en bestrating tot beplanting en renovatie. Wij bouwen de tuin zorgvuldig op als één kloppend geheel.</p></div><a href={page('tuinaanleg/')}>Bekijk tuinaanleg</a></article>
        <article id="onderhoud"><span>02</span><div><h3>Onderhoud</h3><p>Wij verzorgen niet alleen snoeiwerk en groen, maar houden ook verlichting en andere onderdelen van de tuin in het oog.</p></div><a href={page('onderhoud/')}>Bekijk onderhoud</a></article>
        <article id="tuinoptimalisatie"><span>03</span><div><h3>Tuinoptimalisatie</h3><p>Beregening, verlichting en robotmaaiers slim ingesteld, zodat de tuin krijgt wat nodig is en niets onnodig draait.</p></div><a href={page('tuinoptimalisatie/')}>Bekijk optimalisatie</a></article>
      </div>
    </section>

    <section class="projects" id="projecten">
      <header class="projects-heading"><p>Projecten & vakwerk</p><h2>Buiten gemaakt.</h2><p>Eigen werk, gefotografeerd tijdens de aanleg en afwerking.</p></header>
      <div class="project-grid">
        <figure class="project-main"><img src={asset('images/ariaens/bestrating-leggen.webp')} alt="Jaap legt bestrating zorgvuldig op hoogte" width="1400" height="1750" loading="lazy" /><figcaption><span>Bestrating in uitvoering</span><small>Eigen werk</small></figcaption></figure>
        <figure class="project-wide"><img src={asset('images/ariaens/afwatering-detail.webp')} alt="Nauwkeurig afgewerkte lijngoot naast nieuwe bestrating" width="1600" height="1067" loading="lazy" /><figcaption><span>Afwatering & detail</span><small>Eigen werk</small></figcaption></figure>
        <figure class="project-real"><img src={asset('images/ariaens/jaap-aanhanger.webp')} alt="Jaap voor de bedrijfswagen en aanhanger van Ariaens Hoveniers" width="1920" height="1280" loading="lazy" /><figcaption><span>Klaar voor de klus</span><small>Ariaens Hoveniers</small></figcaption></figure>
      </div>
    </section>

    <section class="about section" id="over-ons">
      <div class="about-portrait"><img src={asset('images/ariaens/portret-jaap.webp')} alt="Portret van Jaap Ariaens in zijn werkkleding" width="1280" height="1920" loading="lazy" /><span>Jaap Ariaens</span></div>
      <div class="about-copy"><p class="section-index">Over ons</p><h2>Je weet wie er in je tuin staat.</h2><p class="about-lead">Wij werken persoonlijk, direct en met een vaste groep vakmensen. Jaap blijft zelf betrokken en bewaakt de kwaliteit van begin tot eind.</p><p>Die betrokkenheid begon al vroeg. Op zijn dertiende werkte Jaap mee bij een boer; twee jaar later zette hij zijn eerste stappen bij een hoveniersbedrijf.</p><a class="inline-button" href={page('over-ons/')}>Lees het hele verhaal</a><blockquote>“Als ik klaar denk te zijn, loop ik altijd nog één ronde. Er is altijd een detail dat aandacht verdient.”</blockquote></div>
    </section>

    <section class="certainties"><h2>Zo werken wij.</h2><ul><li><span>01</span><strong>Eén vast aanspreekpunt</strong><p>Direct contact met Jaap, zonder mensen ertussen.</p></li><li><span>02</span><strong>Degelijk opgebouwd</strong><p>Aandacht voor de basis, materialen en lange levensduur.</p></li><li><span>03</span><strong>Netjes achtergelaten</strong><p>Na het werk wordt de tuin verzorgd opgeleverd.</p></li><li><span>04</span><strong>Snel bereikbaar</strong><p>Een vraag of foto deel je gemakkelijk via WhatsApp.</p></li></ul></section>

    <section class="area section"><div><p class="section-index">Dichtbij huis</p><h2>Werkgebied</h2></div><div><p>Wij werken voornamelijk in Wijchen en omgeving. Ook voor passende projecten in Druten en Nijmegen kun je direct contact opnemen.</p><ul aria-label="Werkgebied"><li>Wijchen</li><li>Druten</li><li>Nijmegen</li><li>Directe omgeving</li></ul></div></section>

    <section class="contact" id="contact">
      <div class="contact-inner"><p>Een nieuwe tuin, renovatie of beter onderhoud?</p><h2>Vertel Jaap wat je voor ogen hebt.</h2><a class="button button-light" href={whatsapp}>Start een WhatsApp-gesprek</a><div class="contact-options"><a href="tel:+31631219202">06 31 21 92 02</a><a href="mailto:info@arienshoveniers.nl">info@arienshoveniers.nl</a></div></div>
    </section>
  </main>
  <footer><a class="footer-logo" href="#top"><img src={asset('images/logo.jpg')} alt="Ariaens Hoveniers" width="150" height="150" /></a><div><p>Tuinaanleg · renovatie · onderhoud</p><p>Wijchen en omgeving</p></div><div><a href="https://www.instagram.com/ariaens_hoveniers/">Instagram</a></div><small>Gemaakt door <a href="https://ravi.nl/">Ravi WebDesign</a></small></footer>
  <a class="whatsapp" href={whatsapp} aria-label="Stuur Ariaens Hoveniers een WhatsApp-bericht"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16.1 3.2A12.6 12.6 0 0 0 5.4 22.5L3.7 28.8l6.4-1.7a12.6 12.6 0 1 0 6-23.9Zm0 22.9c-1.9 0-3.7-.5-5.3-1.4l-.4-.2-3.8 1 1-3.7-.2-.4a10.3 10.3 0 1 1 8.7 4.7Zm5.7-7.7c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-.9 1.2-.2.2-.3.2-.7.1-1.8-.9-3-1.6-4.2-3.7-.3-.6.3-.5.9-1.7.1-.2.1-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.2-1.2 3s1.3 3.5 1.5 3.7c.2.2 2.6 4 6.4 5.6.9.4 1.6.6 2.1.8.9.3 1.7.2 2.4.1.7-.1 1.9-.8 2.2-1.5.3-.7.3-1.4.2-1.5-.1-.2-.3-.3-.6-.5Z"/></svg><b>WhatsApp</b></a>
  <script>
    const button = document.querySelector<HTMLButtonElement>('.menu-button'); const menu = document.querySelector<HTMLElement>('#mobile-menu');
    button?.addEventListener('click', () => { const open = button.getAttribute('aria-expanded') === 'true'; button.setAttribute('aria-expanded', String(!open)); if (menu) menu.hidden = open; });
    menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => { button?.setAttribute('aria-expanded', 'false'); if (menu) menu.hidden = true; }));
  </script>
</body>
</html>
