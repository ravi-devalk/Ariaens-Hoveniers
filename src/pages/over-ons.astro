---
import '../styles/global.css';
import Seo from '@jdevalk/astro-seo-graph/Seo.astro';
const base=import.meta.env.BASE_URL; const asset=(p:string)=>`${base}/${p}`.replace(/\/+/g,'/'); const home='../index.html';
const canonical=new URL(`${base}/over-ons/`.replace(/\/+/g,'/'),Astro.site); const title='Over ons | Ariaens Hoveniers | Maak kennis met Jaap'; const description='Maak kennis met Jaap Ariaens: hovenier vanaf jonge leeftijd, vakopgeleid en persoonlijk betrokken bij iedere tuin in Wijchen en omgeving.'; const whatsapp='https://wa.me/31631219202?text=Hallo%20Jaap%2C%20ik%20wil%20graag%20mijn%20tuin%20bespreken.';
const graph={'@context':'https://schema.org','@type':'AboutPage',name:title,description,url:canonical.href,mainEntity:{'@type':'Person',name:'Jaap Ariaens',jobTitle:'Hovenier',worksFor:{'@type':'LandscapingBusiness',name:'Ariaens Hoveniers'}}};
---
<!doctype html><html lang="nl"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#090a09"/><link rel="icon" href={asset('images/logo.jpg')}/><Seo title={title} description={description} canonical={canonical} siteName="Ariaens Hoveniers" locale="nl_NL" ogImage={new URL(asset('images/ariaens/portret-jaap.webp'),Astro.site).href} ogImageAlt="Portret van Jaap Ariaens" graph={graph}/></head><body class="about-page">
<a class="skip-link" href="#inhoud">Ga naar de inhoud</a><header class="site-header inner-header"><a class="wordmark" href={home} aria-label="Naar de homepage"><img src={asset('images/logo.jpg')} alt="" width="150" height="150"/></a><nav aria-label="Hoofdnavigatie"><a href="../tuinaanleg/">Tuinaanleg</a><a href="../onderhoud/">Onderhoud</a><a href="../tuinoptimalisatie/">Tuinoptimalisatie</a><a href={home}>Home</a></nav><a class="button button-small" href={whatsapp}>Bespreek je tuin <span aria-hidden="true">↗</span></a></header>
<main id="inhoud"><svg class="about-vines" viewBox="0 0 1200 3300" preserveAspectRatio="none" aria-hidden="true"><path class="vine-main" pathLength="1" d="M0 0H960C1080 0 1090 90 1090 205C1090 370 1155 405 1155 565V2760C1155 2910 1080 3000 1010 3300"/><path class="vine-main" pathLength="1" d="M0 8H944C1064 8 1074 98 1074 213C1074 378 1139 413 1139 573V2754C1139 2900 1064 2992 994 3300"/><path class="vine-center" pathLength="1" d="M1090 240C980 276 946 370 884 472C820 580 758 650 720 782C690 886 704 1000 672 1118"/><path class="vine-center" pathLength="1" d="M884 472C770 490 694 548 632 650C584 730 558 826 478 884"/><path class="vine-center" pathLength="1" d="M720 782C810 852 836 950 804 1060C780 1140 798 1210 858 1270"/><path class="vine-center" pathLength="1" d="M672 1118C592 1190 570 1280 598 1386C620 1470 584 1544 506 1602"/><path class="vine-branch" pathLength="1" d="M1147 690C1040 735 1022 820 1050 930C1078 1038 1015 1095 906 1130"/><path class="vine-branch" pathLength="1" d="M1147 1040C1190 1135 1178 1225 1105 1312C1022 1412 1038 1512 1110 1600"/><path class="vine-branch" pathLength="1" d="M1147 1600C1040 1650 990 1750 1018 1865C1042 1964 960 2040 848 2080"/><path class="vine-branch" pathLength="1" d="M1147 2140C1210 2240 1190 2350 1108 2450C1030 2545 1028 2660 1088 2760"/><path class="vine-branch" pathLength="1" d="M1147 2610C1055 2700 1028 2812 1010 2940C994 3054 930 3170 822 3298"/><path class="vine-branch" pathLength="1" d="M1132 2830C1200 2905 1190 3050 1144 3140C1118 3190 1100 3250 1092 3300"/></svg><section class="about-intro"><div><p class="intro-label">Het verhaal achter het werk</p><h1>Persoonlijk betrokken.<br/>Van begin tot eind.</h1></div><figure><img src={asset('images/ariaens/portret-jaap.webp')} alt="Portret van Jaap Ariaens in zijn werkkleding" width="1280" height="1920"/></figure></section>
<section class="story section"><aside><span>13 jaar</span><p>De eerste meters buiten</p></aside><div><h2>Het vak begon niet achter een bureau.</h2><p class="story-lead">Op zijn dertiende begon Jaap met onderhoudswerk bij een boer. Daar leerde hij aanpakken, kijken wat een terrein nodig heeft en werk netjes afmaken.</p><p>Twee jaar later ging hij bij een hoveniersbedrijf werken. Vanaf zijn vijftiende groeide zijn ervaring met aanleg, onderhoud, materialen en machines. Na het afronden van de opleiding Hovenier niveau 3 zette hij die kennis om in een eigen bedrijf.</p></div></section>
<section class="work-belief"><div><p>Waar wij voor staan</p><h2>Oog voor detail zit in iedere stap.</h2></div><div class="beliefs"><article><span>01</span><h3>Een degelijke basis</h3><p>De kwaliteit van een tuin begint bij wat later niet meer zichtbaar is. Daarom besteden we aandacht aan constructie, materiaal en afwerking.</p></article><article><span>02</span><h3>Korte lijnen</h3><p>Je bespreekt je wensen rechtstreeks met Jaap. Ook tijdens het werk blijft hij betrokken en weet je wie er in je tuin staat.</p></article><article><span>03</span><h3>Vaste vakmensen</h3><p>Waar extra handen nodig zijn, werken we met een vaste groep zelfstandige vakmensen. Zo blijft het team herkenbaar en de kwaliteit bewaakt.</p></article></div></section>
<section class="story second section"><aside><span>Nu</span><p>Een eigen manier van werken</p></aside><div><h2>Modern vakmanschap, zonder onnodige lagen.</h2><p class="story-lead">Wij combineren praktisch hovenierswerk met slimme systemen voor beregening, verlichting en robotmaaien.</p><p>Zo gaat tuinonderhoud verder dan snoeien en onkruid verwijderen. We kijken naar de hele buitenruimte: wat groeit goed, wat kan slimmer en wat verdient aandacht voordat het een probleem wordt.</p><blockquote>“Als ik klaar denk te zijn, loop ik altijd nog één ronde.”</blockquote></div></section>
<section class="contact about-contact"><div class="contact-inner"><p>Maak kennis met onze manier van werken</p><h2>Zullen we je tuin samen bekijken?</h2><a class="button" href={whatsapp}>Neem contact op <span aria-hidden="true">↗</span></a><div class="contact-options"><a href="tel:+31631219202">06 31 21 92 02</a><a href="mailto:info@arienshoveniers.nl">info@arienshoveniers.nl</a></div></div></section></main>
<footer><a class="footer-logo" href={home}><img src={asset('images/logo.jpg')} alt="Ariaens Hoveniers" width="150" height="150"/></a><div><p>Tuinaanleg · onderhoud · optimalisatie</p><p>Wijchen en omgeving</p></div><div><a href="https://www.instagram.com/ariaens_hoveniers/">Instagram ↗</a><a href={home}>Terug naar home</a></div><small>Gemaakt door <a href="https://ravi.nl/">Ravi WebDesign</a></small></footer><a class="whatsapp" href={whatsapp} aria-label="Stuur Ariaens Hoveniers een WhatsApp-bericht"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16.1 3.2A12.6 12.6 0 0 0 5.4 22.5L3.7 28.8l6.4-1.7a12.6 12.6 0 1 0 6-23.9Zm0 22.9c-1.9 0-3.7-.5-5.3-1.4l-.4-.2-3.8 1 1-3.7-.2-.4a10.3 10.3 0 1 1 8.7 4.7Zm5.7-7.7c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-.9 1.2-.2.2-.3.2-.7.1-1.8-.9-3-1.6-4.2-3.7-.3-.6.3-.5.9-1.7.1-.2.1-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.2-1.2 3s1.3 3.5 1.5 3.7c.2.2 2.6 4 6.4 5.6.9.4 1.6.6 2.1.8.9.3 1.7.2 2.4.1.7-.1 1.9-.8 2.2-1.5.3-.7.3-1.4.2-1.5-.1-.2-.3-.3-.6-.5Z"/></svg><b>WhatsApp</b></a></body></html>
